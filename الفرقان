<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>جمعية الفرقان – قسم الابتدائي</title>
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
--bg:#f6f7f4;--card:#fff;--tx:#1d2b25;--mut:#6b7a72;--pr:#0e5448;--gold:#c9a227;--bd:#dfe5e0;--hifz:#0e5448;--mur:#b7791f}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#121a16;--card:#1b2620;--tx:#e8efe9;--mut:#93a39a;--pr:#2f9c80;--gold:#e3c34a;--bd:#2c3b33;--hifz:#4fc29a;--mur:#e0a84a}}
:root[data-theme="dark"]{--bg:#121a16;--card:#1b2620;--tx:#e8efe9;--mut:#93a39a;--pr:#2f9c80;--gold:#e3c34a;--bd:#2c3b33;--hifz:#4fc29a;--mur:#e0a84a}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font-family:system-ui,"Segoe UI",Tahoma,sans-serif;line-height:1.5}
header{position:sticky;top:env(safe-area-inset-top,0px);background:var(--bg);padding:12px 14px 8px;z-index:5;border-bottom:1px solid var(--bd)}
.brand{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.brand img{width:56px;height:56px;object-fit:cover;border-radius:12px;background:#fff;border:1px solid var(--bd)}
.t1{font-weight:700;font-size:17px;color:var(--pr)}.t2{font-size:13px;color:var(--mut)}
header{border-bottom:3px solid var(--gold)!important}
input,select,textarea,button{font:inherit;color:var(--tx);background:var(--card);border:1px solid var(--bd);border-radius:10px;padding:9px 11px;width:100%}
button{cursor:pointer;width:auto}
button.p{background:var(--pr);color:#fff;border:0}
.wrap{padding:12px 14px 40px;max-width:640px;margin:auto}
.card{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:12px;margin-bottom:10px}
.row{display:flex;gap:8px;align-items:center}
.row>*{flex:1}
.st{display:flex;justify-content:space-between;align-items:center;cursor:pointer}
.st b{font-size:16px}
.badge{font-size:12px;padding:2px 8px;border-radius:99px;border:1px solid var(--bd);color:var(--mut)}
.h{color:var(--hifz)}.m{color:var(--mur)}
.log{border-top:1px solid var(--bd);padding:8px 0;font-size:14px}
.log small{color:var(--mut)}
.tabs{display:flex;gap:6px;margin-bottom:10px}
.tabs button{flex:1}
.tabs .on{background:var(--pr);color:#fff;border:0}
.mut{color:var(--mut);font-size:13px}
.bar{height:10px;background:var(--bd);border-radius:99px;overflow:hidden;margin:6px 0}
.bar i{display:block;height:100%;background:var(--pr);border-radius:99px}
.pers{display:flex;gap:6px;margin:8px 0}.pers button{flex:1;padding:6px}.pers .on{background:var(--pr);color:#fff;border:0}
.lbl{font-size:13px;color:var(--mut);margin:8px 0 3px;display:block}
</style>
</head>
<body>
<div id="login" style="display:none;padding:30px 18px;max-width:420px;margin:auto">
  <div class="card"><div class="brand"><div><div class="t1">تسجيل الدخول</div><div class="t2">جمعية الفرقان – القسم الابتدائي</div></div></div>
  <label class="lbl">اسم المستخدم</label><input id="lu" autocapitalize="off" autocomplete="username">
  <label class="lbl">الرمز السري</label><input id="lp" type="password" inputmode="numeric" autocomplete="current-password">
  <div style="margin-top:12px"><button class="p" id="lb" style="width:100%">دخول</button></div>
  <div id="le" class="mut" style="color:#c0392b;margin-top:8px"></div></div></div>
<header id="hd">
  <div class="brand"><img src="data:image/jpeg;base64," alt="شعار جمعية الفرقان"><div><div class="t1">جمعية الفرقان لتعليم القرآن</div><div class="t2">القسم الابتدائي · متابعة الطلبة</div></div></div>
  <div class="row"><input id="q" placeholder="ابحث عن طالب…"><button id="lo" style="flex:0 0 auto">خروج</button></div>
</header>
<div class="wrap" id="app">
  <div id="report"></div><div id="msg" class="mut"></div><div id="status" class="mut" style="color:var(--pr);font-weight:600"></div>
  <div id="list"></div>
  <div class="card" id="addbox" hidden>
    <b>إضافة طلبة</b>
    <span class="lbl">اكتب كل اسم في سطر (يمكن لصق القائمة كاملة)</span>
    <textarea id="names" rows="4"></textarea>
    <div style="margin-top:8px"><button class="p" id="addbtn">إضافة</button></div>
  </div>
</div>
<script>
const $=id=>document.getElementById(id);
const TEACHERS=[{n:"الشيخ أسامة",r:"حفظ",t:"hifz",u:"osama",h:"8d21a129d727d17ab7f7c08bcd3ec5751b636b281dbdb8d453a66a41eb8ef1b4",admin:1},{n:"الشيخ هارون",r:"مراجعة 1",t:"mur",u:"haroun",h:"5f83a1a0fbbffbed5626ecb428010ce8edb203aeaf4d02ac3fe930914001e2fc"},{n:"الشيخ حذيفة",r:"مراجعة 2",t:"mur",u:"houdhayfa",h:"f740c467927dd4af113e04370b11d4217ccfefb896a9fae8de43a5b669eb58f3"}];
let dbEdit=true,canEdit=false,canAdd=false,known=false,db=null,students=[],logs=[],open=null,form={ti:+(localStorage.getItem("ti")||0)};
const TYPES={hifz:"حفظ",mur:"مراجعة"};
const GRADES=["ممتاز","جيد جدا","جيد","متوسط","يحتاج إعادة"];
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const say=(m,bad)=>{const e=$("status");e.textContent=m;e.style.color=bad?"#c0392b":"var(--pr)";};
const NODB="تعذّر الاتصال بالخادم. تحقق من الإنترنت ثم أعد المحاولة.";
const today=()=>new Date().toISOString().slice(0,10);

function startOf(per){
  const d=new Date();
  if(per==="week"){d.setDate(d.getDate()-((d.getDay()+6)%7));}
  if(per==="month"){d.setDate(1);}
  const z=n=>String(n).padStart(2,"0");return d.getFullYear()+"-"+z(d.getMonth()+1)+"-"+z(d.getDate());
}
function report(){
  const per=form.per||"day",st=startOf(per);
  const inP=logs.filter(l=>l.date>=st&&l.date<=today());
  let h=`<div class="card"><b>📊 تقرير الإنجاز</b>
  <div class="pers">${[["day","اليوم"],["week","هذا الأسبوع"],["month","هذا الشهر"]].map(p=>`<button data-per="${p[0]}" class="${per==p[0]?"on":""}">${p[1]}</button>`).join("")}</div>`;
  if(!students.length)return h+'<div class="mut">أضف الطلبة لتظهر النسب.</div></div>';
  TEACHERS.forEach((t,i)=>{
    const done=new Set(inP.filter(l=>l.teacher===t.n).map(l=>l.sid));
    const n=students.filter(s=>done.has(s.id)).length,tot=students.length,pc=Math.round(n*100/tot);
    const miss=students.filter(s=>!done.has(s.id));
    h+=`<div style="margin-top:10px"><div class="row" style="justify-content:space-between"><b>${t.n} <span class="mut">(${t.r})</span></b><b>${pc}%</b></div>
    <div class="bar"><i style="width:${pc}%"></i></div>
    <div class="mut">${n} من ${tot} طالب</div>
    ${miss.length?`<details><summary class="mut" style="cursor:pointer">لم يُسجَّل لهم (${miss.length})</summary><div class="mut">${miss.map(m=>esc(m.name)).join("، ")}</div></details>`:""}</div>`;
  });
  return h+"</div>";
}
function render(){
  $("report").innerHTML=report();
  $("addbox").hidden=!canAdd;
  const q=$("q").value.trim();
  const list=students.filter(s=>!q||s.name.includes(q));
  if(!db){$("msg").textContent="جارٍ تحميل البيانات…";}
  else if(!students.length){$("msg").textContent="لا يوجد طلبة بعد. "+(canAdd?"أضف الأسماء من الأسفل.":"")+"";}
  else $("msg").textContent=students.length+" طالب";
  $("list").innerHTML=list.map(s=>{
    const L=logs.filter(l=>l.sid===s.id).sort((a,b)=>(b.date+b.ts).localeCompare(a.date+a.ts));
    const last=L[0];
    let h=`<div class="card"><div class="st" data-o="${s.id}"><b>${esc(s.name)}</b>
      <span class="badge">${last?esc(last.date)+" · "+esc(last.role||TYPES[last.type]):"بدون سجل"}</span></div>`;
    if(open===s.id){
      h+=`<label class="lbl" style="margin-top:10px">الأستاذ</label>
        <select id="f_tch" ${known?"disabled":""}>${TEACHERS.map((t,i)=>`<option value="${i}" ${i==form.ti?"selected":""}>${t.n} — ${t.r}</option>`).join("")}</select>
        <label class="lbl">ما تم (سورة / من آية إلى آية)</label><input id="f_det">
        <div class="row"><div><label class="lbl">التقدير</label>
          <select id="f_gr"><option>ممتاز</option><option>جيد جدا</option><option>جيد</option><option>متوسط</option><option>يحتاج إعادة</option></select></div>
          <div><label class="lbl">التاريخ</label><input type="date" id="f_dt" value="${today()}"></div></div>
        <label class="lbl">ملاحظة</label><input id="f_nt">
        <div style="margin-top:10px" class="row"><button class="p" data-save="${s.id}">حفظ التسجيل</button>
        ${!canEdit?"":form.cd===s.id?`<button data-del2="${s.id}" style="flex:0 0 auto;background:#c0392b;color:#fff;border:0">تأكيد الحذف النهائي</button><button data-cancel="1" style="flex:0 0 auto">إلغاء</button>`:`<button data-del="${s.id}" style="flex:0 0 auto">حذف الطالب</button>`}</div>
        <div style="margin-top:10px">`+
        (L.length?L.map(l=>l.id===form.el?`<div class="log"><b class="${l.type=="hifz"?"h":"m"}">${esc(l.role||TYPES[l.type])}</b> — ${esc(l.teacher||"")}
          <label class="lbl">ما تم</label><input id="e_det" value="${esc(l.detail)}">
          <div class="row"><div><label class="lbl">التقدير</label><select id="e_gr">${(GRADES.includes(l.grade)?GRADES:[l.grade].concat(GRADES)).map(g=>`<option ${g===l.grade?"selected":""}>${esc(g)}</option>`).join("")}</select></div>
          <div><label class="lbl">التاريخ</label><input type="date" id="e_dt" value="${esc(l.date)}"></div></div>
          <label class="lbl">ملاحظة</label><input id="e_nt" value="${esc(l.note)}">
          <div class="row" style="margin-top:8px"><button class="p" data-esave="${l.id}">حفظ التعديل</button><button data-cancel="1" style="flex:0 0 auto">إلغاء</button></div></div>`
          :`<div class="log"><b class="${l.type=="hifz"?"h":"m"}">${esc(l.role||TYPES[l.type])}</b> — ${esc(l.detail)} · ${esc(l.grade)}<br>
          <small>${esc(l.date)} · ${esc(l.teacher||"")} ${l.note?"· "+esc(l.note):""}</small>
          <div class="row" style="margin-top:6px"><button data-edit="${l.id}" style="flex:0 0 auto">✏️ تعديل</button>${form.dl===l.id?`<button data-dlog2="${l.id}" style="flex:0 0 auto;background:#c0392b;color:#fff;border:0">تأكيد حذف التسجيل</button><button data-cancel="1" style="flex:0 0 auto">إلغاء</button>`:`<button data-dlog="${l.id}" style="flex:0 0 auto">🗑 حذف</button>`}</div></div>`).join(""):'<div class="mut">لا توجد تسجيلات.</div>')+`</div>`;
    }
    return h+"</div>";
  }).join("");
}

$("q").oninput=render;
$("report").onclick=e=>{const b=e.target.closest("[data-per]");if(b){form.per=b.dataset.per;render();}};
$("list").onclick=async e=>{
  const t=e.target.closest("[data-o],[data-save],[data-del],[data-del2],[data-cancel],[data-edit],[data-esave],[data-dlog],[data-dlog2]");if(!t)return;
  if(t.dataset.o){open=open===t.dataset.o?null:t.dataset.o;return render();}
    if(t.dataset.del){form.cd=t.dataset.del;say("اضغط «تأكيد الحذف النهائي» لحذف الطالب وكل تسجيلاته.",1);return render();}
  if(t.dataset.cancel){form.cd=null;form.el=null;form.dl=null;say("");return render();}
  if(t.dataset.edit){form.el=t.dataset.edit;form.dl=null;say("");return render();}
  if(t.dataset.dlog){form.dl=t.dataset.dlog;form.el=null;say("اضغط «تأكيد حذف التسجيل» لحذف هذا التسجيل فقط.",1);return render();}
  if(!cred){say(NODB,1);return;}
  try{
    if(t.dataset.save){
      const det=$("f_det").value.trim();if(!det){$("f_det").focus();return;}
      const T=TEACHERS[+$("f_tch").value];form.ti=+$("f_tch").value;localStorage.setItem("ti",form.ti);
      say("جارٍ الحفظ…");await api("addLog",{log:{sid:t.dataset.save,detail:det,grade:$("f_gr").value,date:$("f_dt").value,note:$("f_nt").value.trim()}});await refresh(true);say("✓ تم حفظ التسجيل");
    }
    if(t.dataset.esave){
      const det=$("e_det").value.trim();if(!det){$("e_det").focus();return;}
      say("جارٍ حفظ التعديل…");await api("updateLog",{log:{id:t.dataset.esave,detail:det,grade:$("e_gr").value,date:$("e_dt").value,note:$("e_nt").value.trim()}});form.el=null;await refresh(true);say("✓ تم حفظ التعديل");
    }
    if(t.dataset.dlog2){
      say("جارٍ الحذف…");await api("deleteLog",{id:t.dataset.dlog2});form.dl=null;await refresh(true);say("✓ تم حذف التسجيل");
    }
    if(t.dataset.del2){
      const id=t.dataset.del2;say("جارٍ الحذف…");
      await api("deleteStudent",{id});await refresh(true);open=null;form.cd=null;say("✓ تم حذف الطالب");
    }
  }catch(err){say("تعذّرت العملية: "+(err.code||"")+" "+(err.message||"")+"",1);}
};
$("addbtn").onclick=async()=>{
  if(!cred){say(NODB,1);return;}
  const names=$("names").value.split("\n").map(x=>x.trim()).filter(Boolean);
  if(!names.length){say("اكتب اسماً واحداً على الأقل",1);return;}
  try{say("جارٍ الإضافة…");await api("addStudents",{names});await refresh(true);$("names").value="";say("✓ تمت إضافة "+names.length+" طالب");}
  catch(err){say("تعذّرت الإضافة: "+(err.code||"")+" "+(err.message||"")+"",1);}
};

const API="https://script.google.com/macros/s/AKfycbzLXCnN3qx4vrfpnZA7rcie-4_QYsPqC80q1Qj-pR624PXUouNQwoN32IuNatLGs5xo6Q/exec"; // رابط تطبيق الويب من Google Apps Script
let cred=null,last="";
async function api(action,data){
  const r=await fetch(API,{method:"POST",headers:{"Content-Type":"text/plain;charset=utf-8"},body:JSON.stringify({action,u:cred.u,h:cred.h,...data})});
  const j=await r.json();if(!j.ok)throw new Error(j.error==="auth"?"بيانات الدخول غير صحيحة":(j.error||"خطأ"));return j;
}
async function refresh(force){
  if(!cred)return;
  const a=document.activeElement;
  if(!force&&(form.el||form.dl))return;
  if(!force&&a&&a.closest&&a.closest("#list")&&/INPUT|SELECT|TEXTAREA/.test(a.tagName))return;
  try{
    const j=await api("list");const sig=JSON.stringify([j.students,j.logs]);
    if(!force&&sig===last)return;last=sig;
    students=(j.students||[]).sort((a,b)=>a.name.localeCompare(b.name,"ar"));logs=j.logs||[];db=true;render();
  }catch(e){say(e.message==="Failed to fetch"?NODB:e.message,1);}
}
let cur=null;
const sha=async t=>[...new Uint8Array(await crypto.subtle.digest("SHA-256",new TextEncoder().encode(t)))].map(b=>b.toString(16).padStart(2,"0")).join("");
function setUser(){
  const T=cur!=null?TEACHERS[cur]:null;
  cred=T?{u:T.u,h:T.h}:null;
  $("login").style.display=T?"none":"block";$("hd").style.display=T?"":"none";$("app").style.display=T?"":"none";
  if(T){form.ti=cur;known=true;canEdit=dbEdit;canAdd=dbEdit;}
  render();
}
$("lb").onclick=async()=>{
  const u=$("lu").value.trim().toLowerCase(),p=$("lp").value.trim();
  const i=TEACHERS.findIndex(t=>t.u===u);
  if(i<0||await sha("furqan:"+u+":"+p)!==TEACHERS[i].h){$("le").textContent="اسم المستخدم أو الرمز السري غير صحيح";return;}
  cur=i;$("le").textContent="";$("lp").value="";try{localStorage.setItem("cu",String(i)+":"+TEACHERS[i].h)}catch(e){}
  setUser();say("مرحباً "+TEACHERS[i].n+" ("+TEACHERS[i].r+")");refresh(true);
};
$("lp").onkeydown=e=>{if(e.key==="Enter")$("lb").click();};
$("lo").onclick=()=>{cur=null;known=false;canEdit=false;canAdd=false;students=[];logs=[];db=null;try{localStorage.removeItem("cu")}catch(e){}setUser();};
try{const v=(localStorage.getItem("cu")||"").split(":");if(v[0]!==""&&TEACHERS[+v[0]]&&TEACHERS[+v[0]].h===v[1])cur=+v[0];}catch(e){}
(async()=>{setUser();await refresh(true);setInterval(()=>refresh(false),20000);})();
</script>
</body>
</html>
